---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import NetworkField from '../components/NetworkField.astro';

const channels = [
  {
    label: 'Email',
    value: 'anton@kokofibo.com',
    href: 'mailto:anton@kokofibo.com',
  },
  {
    label: 'WhatsApp',
    value: '0817-2658-8836',
    href: 'https://wa.me/6281726588836',
  },
  {
    label: 'Lokasi',
    value: 'Indonesia — Remote-first',
    href: null,
  },
];
---

<BaseLayout
  title="Kontak"
  description="Hubungi Kokofibo untuk mendiskusikan website, trading system, atau HR & payroll automation untuk bisnis Anda."
>
  <section class="relative overflow-hidden pt-36 pb-20">
    <NetworkField class="opacity-30" />
    <div class="container-kf relative grid gap-14 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <span class="eyebrow reveal-up">Kontak</span>
        <h1 class="reveal-up mt-5 text-balance font-display text-4xl font-semibold leading-tight text-paper sm:text-5xl">
          Mari bicarakan sistem Anda.
        </h1>
        <p class="reveal-up mt-6 max-w-md text-base leading-relaxed text-paper/60">
          Isi form di samping, atau hubungi kami langsung lewat kanal berikut. Kami biasanya membalas dalam 1×24 jam kerja.
        </p>

        <div class="reveal-stagger mt-10 space-y-5">
          {channels.map((c) => (
            <div class="flex items-center justify-between border-b border-ink-line pb-4">
              <span class="font-mono text-xs uppercase tracking-widest2 text-paper/40">{c.label}</span>
              {c.href ? (
                <a href={c.href} class="font-display text-sm font-medium text-paper hover:text-signal">{c.value}</a>
              ) : (
                <span class="font-display text-sm font-medium text-paper">{c.value}</span>
              )}
            </div>
          ))}
        </div>

        <div class="reveal-up mt-10 rounded-2xl border border-ink-line bg-ink-soft p-6">
          <p class="eyebrow">Waktu Respons</p>
          <p class="mt-3 text-sm leading-relaxed text-paper/60">
            Senin–Jumat, 09.00–18.00 WIB. Pesan di luar jam kerja akan dibalas di hari kerja berikutnya.
          </p>
        </div>
      </div>

      <div class="reveal-up rounded-2xl border border-ink-line bg-ink-soft p-6 sm:p-8">
        <h2 class="font-display text-xl font-semibold text-paper">Ceritakan proyek Anda</h2>
        <p class="mt-2 text-sm text-paper/50">Semakin detail, semakin cepat kami bisa merespons dengan tepat.</p>
        <div class="mt-8">
          <ContactForm />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
