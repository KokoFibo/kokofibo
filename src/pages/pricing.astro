      description: 'Satu halaman company profile atau produk, siap dipakai untuk kebutuhan marketing.',
      features: ['1 halaman, desain custom', 'Mobile friendly & SEO dasar', 'Form kontak', 'Revisi 2x'],
    },
    {
      name: 'Business Website',
      price: 'Rp 15jt',
      description: 'Website multi-halaman untuk perusahaan yang butuh presence lengkap.',
      features: ['5–8 halaman custom', 'CMS sederhana untuk konten', 'SEO on-page penuh', 'Animasi & interaksi', 'Revisi 3x'],
      featured: true,
    },
    {
