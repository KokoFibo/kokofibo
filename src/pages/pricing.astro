      features: ['Multi-layer entry logic', 'Copy trading lintas akun', 'Panel kontrol custom', 'Auto-close & trailing stop'],
      featured: true,
    },
    {
      name: 'Enterprise Trading System',
      price: 'Custom',
      description: 'Sistem trading skala besar dengan monitoring, multi-strategi, dan infrastruktur khusus.',
      features: ['Multi-strategi & multi-akun', 'Monitoring & alert real-time', 'SLA & maintenance berkala'],
    },
  ],
  hr: [
    {
      name: 'HR Module Setup',
      price: 'Mulai Rp 12jt',
      description: 'Modul HR dasar: data karyawan, absensi, dan struktur organisasi.',
      features: ['Database karyawan', 'Absensi otomatis', 'Struktur organisasi & role'],
    },
    {
      name: 'Payroll Automation',
      price: 'Mulai Rp 25jt',
      description: 'Perhitungan gaji otomatis lengkap dengan PPh 21 dan slip gaji digital.',
      features: ['Perhitungan payroll & PPh 21', 'Slip gaji digital', 'Export laporan Excel', 'Approval berjenjang'],
      featured: true,
    },
    {
      name: 'Multi-brand Enterprise',
      price: 'Custom',
      description: 'Sistem HR & payroll terpusat untuk grup dengan beberapa brand/subdomain.',
      features: ['Transfer karyawan antar-brand', 'API terpusat multi-subdomain', 'Reporting konsolidasi'],
    },
  ],
  ai: [
    {
      name: 'AI Chatbot Starter',
      price: 'Mulai Rp 10jt',
      description: 'Chatbot AI untuk satu channel (WhatsApp/website) dengan skenario percakapan yang sudah ditentukan.',
      features: ['1 channel (WhatsApp/web)', 'Skenario percakapan custom', 'Koneksi ke 1 sumber data', 'Testing & handover'],
