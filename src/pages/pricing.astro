---

<BaseLayout
  title="Harga"
  description="Paket harga Kokofibo untuk pengembangan website, trading system, HR & payroll automation, otomasi agentic AI, hingga maintenance berkala."
>
  <section class="relative overflow-hidden pt-36 pb-16">
    <NetworkField class="opacity-25" />
    <div class="container-kf relative">
      <span class="eyebrow reveal-up">Harga</span>
      <h1 class="reveal-up mt-5 max-w-2xl text-balance font-display text-4xl font-semibold leading-tight text-paper sm:text-5xl">
        Paket yang jelas, tanpa biaya tersembunyi.
      </h1>
      <p class="reveal-up mt-6 max-w-xl text-base leading-relaxed text-paper/60">
        Harga di bawah adalah titik awal. Setiap proyek tetap kami diskusikan dulu supaya penawaran sesuai kebutuhan sebenarnya.
      </p>
    </div>
  </section>

  <section class="relative border-t border-ink-line pb-28 pt-12">
    <div class="container-kf">
      <div class="reveal-up flex flex-wrap gap-3" role="tablist" aria-label="Kategori harga">
        {tabs.map((t, i) => (
          <button
            class="pricing-tab tag-mono !py-2 !px-4 transition-colors data-[active=true]:!border-signal data-[active=true]:!text-signal"
            data-tab={t.key}
            data-active={i === 0 ? 'true' : 'false'}
            id={t.key}
            type="button"
          >
            {t.label}
          </button>
        ))}
      </div>

      {tabs.map((t, i) => (
        <div class="pricing-panel mt-12 grid gap-6 md:grid-cols-3" data-panel={t.key} style={i === 0 ? '' : 'display:none'}>
          {plans[t.key as keyof typeof plans].map((p) => <PricingCard {...p} />)}
        </div>
      ))}

      <p class="reveal-up mt-14 text-center font-mono text-xs text-paper/35">
        * Semua harga dalam Rupiah, tidak termasuk PPN. Estimasi timeline diberikan setelah scope disepakati.
      </p>
    </div>
  </section>

  <section class="relative border-t border-ink-line py-20 text-center">
    <div class="container-kf reveal-up">
      <h2 class="mx-auto max-w-xl text-balance font-display text-3xl font-semibold text-paper sm:text-4xl">
        Tidak yakin paket mana yang cocok?
      </h2>
      <p class="mx-auto mt-4 max-w-md text-paper/60">
        Ceritakan kebutuhan Anda, kami bantu rekomendasikan paket yang paling pas.
      </p>
      <a href="/contact" class="btn-primary mt-8 inline-flex">Konsultasi Gratis</a>
    </div>
  </section>
</BaseLayout>

<script>
  import { gsap } from 'gsap';

  const tabButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.pricing-tab'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.pricing-panel'));

  function activate(key: string) {
    tabButtons.forEach((b) => (b.dataset.active = String(b.dataset.tab === key)));
    panels.forEach((panel) => {
      if (panel.dataset.panel === key) {
        panel.style.display = '';
        gsap.fromTo(panel.children, { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.45, stagger: 0.08, ease: 'power2.out' });
      } else {
        panel.style.display = 'none';
      }
    });
  }

  tabButtons.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const key = btn.dataset.tab || 'web';
      activate(key);
      history.replaceState(null, '', `#${key}`);
    });
  });

  const initialHash = window.location.hash.replace('#', '');
  if (initialHash && tabButtons.some((b) => b.dataset.tab === initialHash)) {
    activate(initialHash);
  }
</script>
