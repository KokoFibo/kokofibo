---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
// Self-hosted fonts (latin subset): no third-party connections on the critical path.
// Space Grotesk (headings) is declared in global.css with font-display: optional.
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import headingFont from '@fontsource/space-grotesk/files/space-grotesk-latin-600-normal.woff2?url';
import bodyFont from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const {
  title,
  description,
  ogImage = '/images/og-cover.png',
} = Astro.props;

const siteName = 'Kokofibo';
const hasBrand = title.toLowerCase().includes(siteName.toLowerCase());
const fullTitle = hasBrand ? title : `${title} · ${siteName}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalURL} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0A0A0C" />
    <meta name="author" content="Kokofibo" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${siteName} — ${description}`} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="id_ID" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    <!-- Fonts: the two used above the fold are preloaded -->
    <link rel="preload" as="font" type="font/woff2" href={headingFont} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={bodyFont} crossorigin />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'Kokofibo',
      url: 'https://kokofibo.com',
      logo: 'https://kokofibo.com/favicon-32x32.png',
      image: 'https://kokofibo.com/images/og-cover.png',
      email: 'anton@kokofibo.com',
      telephone: '+62 817-2658-8836',
      founder: {
        '@type': 'Person',
        name: 'Anton Phan',
      },
      description:
        'Kokofibo membangun sistem digital: platform web bisnis, automasi HR & payroll, trading system, dan otomasi agentic AI, untuk perusahaan yang bergerak cepat.',
    })} />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-K0472YMGXG"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-K0472YMGXG');
    </script>
  </head>
  <body class="bg-node-grid">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      import { initScrollReveal } from '../lib/scrollReveal';
      const boot = () => initScrollReveal();
      if (document.readyState !== 'loading') boot();
      else document.addEventListener('DOMContentLoaded', boot);
    </script>
  </body>
</html>
