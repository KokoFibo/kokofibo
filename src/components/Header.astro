---
import LogoMark from './LogoMark.astro';

const nav = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'Tentang Kami' },
  { href: '/portfolio', label: 'Portfolio' },
  { href: '/pricing', label: 'Harga' },
  { href: '/contact', label: 'Kontak' },
];

const current = Astro.url.pathname;
---

<header class="fixed inset-x-0 top-0 z-50" id="site-header">
  <div class="container-kf">
    <div
      id="header-inner"
      class="mt-4 flex items-center justify-between rounded-2xl border border-ink-line/0 bg-ink/0 px-4 py-3 transition-all duration-300 sm:px-5"
    >
      <a href="/" aria-label="Kokofibo — Beranda">
        <LogoMark />
      </a>

      <nav class="hidden items-center gap-8 md:flex" aria-label="Navigasi utama">
        {nav.map((item) => (
          <a
            href={item.href}
            class={`font-mono text-[13px] uppercase tracking-widest2 transition-colors ${
              current === item.href ? 'text-signal' : 'text-paper/70 hover:text-paper'
            }`}
          >
            {item.label}
          </a>
        ))}
      </nav>

      <a href="/contact" class="btn-primary hidden !px-5 !py-2.5 !text-xs md:inline-flex">
        Mulai Proyek
      </a>

      <button
        id="menu-toggle"
        class="flex h-10 w-10 items-center justify-center rounded-full border border-ink-line text-paper md:hidden"
        aria-label="Buka menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="icon-open" width="18" height="18" viewBox="0 0 18 18" fill="none">
          <path d="M1 4H17M1 9H17M1 14H17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
        <svg id="icon-close" width="18" height="18" viewBox="0 0 18 18" fill="none" class="hidden">
          <path d="M2 2L16 16M16 2L2 16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <div
      id="mobile-menu"
      class="mt-2 hidden flex-col gap-1 rounded-2xl border border-ink-line bg-ink-soft p-4 md:hidden"
    >
      {nav.map((item) => (
        <a
          href={item.href}
          class={`rounded-lg px-3 py-3 font-mono text-sm uppercase tracking-wide ${
            current === item.href ? 'text-signal' : 'text-paper/80'
          }`}
        >
          {item.label}
        </a>
      ))}
      <a href="/contact" class="btn-primary mt-2 w-full !py-3 !text-sm">Mulai Proyek</a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');
  const headerInner = document.getElementById('header-inner');

  toggle?.addEventListener('click', () => {
    const isHidden = menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    menu?.classList.toggle('flex');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!!isHidden));
  });

  const onScroll = () => {
    if (!headerInner) return;
    if (window.scrollY > 12) {
      headerInner.classList.add('border-ink-line', 'bg-ink/80', 'backdrop-blur-lg', 'shadow-[0_4px_30px_rgba(0,0,0,0.35)]');
    } else {
      headerInner.classList.remove('border-ink-line', 'bg-ink/80', 'backdrop-blur-lg', 'shadow-[0_4px_30px_rgba(0,0,0,0.35)]');
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
