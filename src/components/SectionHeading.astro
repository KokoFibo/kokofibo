---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  class?: string;
}
const { eyebrow, title, description, align = 'left', class: className = '' } = Astro.props;
---
<div class={`reveal-up max-w-2xl ${align === 'center' ? 'mx-auto text-center' : ''} ${className}`}>
  <span class="eyebrow">{eyebrow}</span>
  <h2 class="mt-4 text-3xl font-semibold text-paper text-balance sm:text-4xl lg:text-[2.75rem]">
    {title}
  </h2>
  {description && (
    <p class="mt-4 text-base leading-relaxed text-paper/60">{description}</p>
  )}
</div>
