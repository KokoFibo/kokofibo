---
interface Props {
  kind: 'trading' | 'payroll' | 'tax' | 'web' | 'ai' | 'tool';
  tag: string;
  title: string;
  description: string;
  stack: string[];
}
const { kind, tag, title, description, stack } = Astro.props;
---
<article class="card-kf group flex h-full flex-col overflow-hidden !p-0">
  <div class="relative flex h-48 items-center justify-center overflow-hidden border-b border-ink-line bg-ink-raised">
    <div class="absolute inset-0 bg-node-grid opacity-40"></div>

    {kind === 'trading' && (
      <svg viewBox="0 0 320 140" class="relative h-28 w-56">
        <polyline points="0,100 30,90 55,110 80,60 105,75 130,40 155,55 180,20 205,45 230,15 255,35 280,10 320,25"
          fill="none" stroke="#FF5A1F" stroke-width="2.5" />
        <polyline points="0,100 30,90 55,110 80,60 105,75 130,40 155,55 180,20 205,45 230,15 255,35 280,10 320,25 320,140 0,140"
          fill="url(#tradingFill)" opacity="0.25" stroke="none" />
        <defs>
          <linearGradient id="tradingFill" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#FF5A1F"/>
            <stop offset="100%" stop-color="#FF5A1F" stop-opacity="0"/>
          </linearGradient>
        </defs>
        <g fill="#FFA23D"><circle cx="180" cy="20" r="3.5"/><circle cx="280" cy="10" r="3.5"/></g>
      </svg>
    )}

    {kind === 'payroll' && (
      <svg viewBox="0 0 320 140" class="relative h-28 w-56">
        <g stroke="#FF5A1F" stroke-width="1.5" opacity="0.5">
          <line x1="160" y1="20" x2="80" y2="60"/>
          <line x1="160" y1="20" x2="240" y2="60"/>
          <line x1="80" y1="60" x2="40" y2="110"/>
          <line x1="80" y1="60" x2="120" y2="110"/>
          <line x1="240" y1="60" x2="200" y2="110"/>
          <line x1="240" y1="60" x2="280" y2="110"/>
        </g>
        <circle cx="160" cy="20" r="9" fill="#FF5A1F"/>
        <g fill="#FFA23D">
          <circle cx="80" cy="60" r="7"/><circle cx="240" cy="60" r="7"/>
        </g>
        <g fill="#F8F6F2" opacity="0.85">
          <circle cx="40" cy="110" r="5.5"/><circle cx="120" cy="110" r="5.5"/>
          <circle cx="200" cy="110" r="5.5"/><circle cx="280" cy="110" r="5.5"/>
        </g>
      </svg>
    )}

    {kind === 'tax' && (
      <svg viewBox="0 0 320 140" class="relative h-28 w-56">
        <g>
          <rect x="40" y="70" width="26" height="45" fill="#FF5A1F" opacity="0.85"/>
          <rect x="82" y="50" width="26" height="65" fill="#FFA23D" opacity="0.85"/>
          <rect x="124" y="85" width="26" height="30" fill="#FF5A1F" opacity="0.55"/>
          <rect x="166" y="35" width="26" height="80" fill="#FFA23D"/>
          <rect x="208" y="60" width="26" height="55" fill="#FF5A1F" opacity="0.7"/>
          <rect x="250" y="20" width="26" height="95" fill="#FF5A1F"/>
        </g>
        <line x1="30" y1="118" x2="290" y2="118" stroke="#F8F6F2" stroke-opacity="0.3" stroke-width="1.5"/>
      </svg>
    )}

    {kind === 'web' && (
      <svg viewBox="0 0 320 140" class="relative h-28 w-56">
        <rect x="20" y="15" width="280" height="110" rx="8" fill="none" stroke="#F8F6F2" stroke-opacity="0.25" stroke-width="1.5"/>
        <line x1="20" y1="40" x2="300" y2="40" stroke="#F8F6F2" stroke-opacity="0.25" stroke-width="1.5"/>
        <circle cx="35" cy="27" r="3" fill="#FF5A1F"/>
        <circle cx="47" cy="27" r="3" fill="#FFA23D" opacity="0.7"/>
        <circle cx="59" cy="27" r="3" fill="#F8F6F2" opacity="0.4"/>
        <rect x="36" y="55" width="90" height="10" rx="2" fill="#FF5A1F"/>
        <rect x="36" y="72" width="140" height="6" rx="2" fill="#F8F6F2" opacity="0.3"/>
        <rect x="36" y="84" width="110" height="6" rx="2" fill="#F8F6F2" opacity="0.2"/>
        <rect x="200" y="55" width="80" height="55" rx="6" fill="#FFA23D" opacity="0.18" stroke="#FFA23D" stroke-width="1.2"/>
      </svg>
    )}

    {kind === 'ai' && (
      <svg viewBox="0 0 320 140" class="relative h-28 w-56">
        <g stroke="#FF5A1F" stroke-width="1.5" stroke-dasharray="4 3" opacity="0.6">
          <line x1="60" y1="70" x2="130" y2="70"/>
          <line x1="190" y1="70" x2="260" y2="70"/>
        </g>
        <rect x="14" y="48" width="46" height="44" rx="8" fill="none" stroke="#F8F6F2" stroke-opacity="0.4" stroke-width="1.5"/>
        <circle cx="37" cy="70" r="6" fill="#F8F6F2" fill-opacity="0.6"/>
        <rect x="130" y="35" width="60" height="70" rx="10" fill="#1B1B20" stroke="#FF5A1F" stroke-width="2"/>
        <circle cx="150" cy="60" r="4" fill="#FFA23D"/>
        <circle cx="170" cy="60" r="4" fill="#FFA23D"/>
        <path d="M148 80q12 10 24 0" stroke="#FF5A1F" stroke-width="2" fill="none" stroke-linecap="round"/>
        <rect x="260" y="48" width="46" height="44" rx="8" fill="none" stroke="#F8F6F2" stroke-opacity="0.4" stroke-width="1.5"/>
        <path d="M275 70l6 6l12 -14" stroke="#FFA23D" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    )}

    {kind === 'tool' && (
      <svg viewBox="0 0 320 140" class="relative h-28 w-56">
        <rect x="40" y="30" width="90" height="80" rx="8" fill="none" stroke="#F8F6F2" stroke-opacity="0.35" stroke-width="1.5"/>
        <circle cx="65" cy="55" r="7" fill="#FFA23D"/>
        <path d="M40 100l25-25l18 18l25-30l22 22" fill="none" stroke="#F8F6F2" stroke-opacity="0.35" stroke-width="1.5"/>
        <g stroke="#FF5A1F" stroke-width="2" stroke-linecap="round">
          <path d="M155 70h30"/>
          <path d="M177 60l8 10l-8 10"/>
        </g>
        <rect x="205" y="45" width="70" height="50" rx="8" fill="#1B1B20" stroke="#FF5A1F" stroke-width="2"/>
        <text x="240" y="75" text-anchor="middle" font-family="monospace" font-size="14" fill="#FFA23D">WebP</text>
      </svg>
    )}

    <span class="absolute right-4 top-4 tag-mono !bg-ink/70">{tag}</span>
  </div>

  <div class="flex flex-1 flex-col p-6">
    <h3 class="font-display text-lg font-semibold text-paper">{title}</h3>
    <p class="mt-2.5 text-sm leading-relaxed text-paper/60">{description}</p>
    <div class="mt-5 flex flex-wrap gap-2">
      {stack.map((s) => (
        <span class="rounded-full border border-ink-line px-2.5 py-1 font-mono text-[10px] uppercase tracking-wide text-paper/50">{s}</span>
      ))}
    </div>
  </div>
</article>
